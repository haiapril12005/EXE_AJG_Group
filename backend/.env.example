# Website and API share this port.
PORT=3000
WEB_ORIGIN=http://localhost:3000
# Number of reverse proxies in front of the API: 0 locally, 1 on Render.
TRUST_PROXY=0
SUPABASE_URL=https://your-project.supabase.co
# Safe to expose to the browser; use the same value as the frontend publishable key.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Keep private. Use your Supabase secret key; never expose it to the browser.
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Defaults to the project's well-known JWKS endpoint if omitted.
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# Optional until you enable Gemini AI analysis.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_STT_MODEL=gemini-3.5-transcribe
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore
# The API refreshes the job catalog when its newest posting is older than this; 0 turns it off.
JOB_SYNC_INTERVAL_HOURS=12
# Leave all three blank for free, unlimited local testing.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:3000/?payment=success
PAYOS_CANCEL_URL=http://localhost:3000/?payment=cancelled
