{
  "name": "cv-fit-mvp",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace backend",
    "start": "npm run start --workspace backend",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "typecheck": "npm run typecheck --workspace backend && npm run typecheck --workspace frontend",
    "test": "npm run test --workspace backend && npm run test:auth",
    "test:auth": "node --import tsx --test frontend/test/auth-flow.test.ts",
    "test:auth-ui": "playwright test",
    "db:check": "node scripts/check-supabase.mjs",
    "jobs:sync": "npm run jobs:sync --workspace backend --",
    "auth:check": "node scripts/check-auth-email.mjs",
    "admin:list": "node scripts/manage-admin.mjs list",
    "admin:grant": "node scripts/manage-admin.mjs grant",
    "admin:revoke": "node scripts/manage-admin.mjs revoke"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3"
  }
}
